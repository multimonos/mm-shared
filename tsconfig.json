{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "ignoreDeprecations": "6.0",
    "rootDir": "src",
    "strict": false,
    "declaration": true,      // Changed: Generates type definitions for your apps
    "declarationMap": true,   // New: Let's you "Go to Definition" in your editor
    "allowJs": true,
    "checkJs": false,
    "esModuleInterop": true,
    "skipLibCheck": true,     // Prevents library type conflicts
    "isolatedModules": true   // Vital for Vite/SvelteKit compatibility
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules"]
}
